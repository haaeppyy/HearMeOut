<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. Xcode rewrites this to production on archive with
	     a distribution profile; development is correct for day-to-day runs.
	     Must match APNS_ENVIRONMENT on the backend (sandbox vs production). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
